{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "api_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "models": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "output_format": {
            "type": "string",
            "enum": ["png", "jpeg", "webp"]
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "quality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "orchestration_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "profile": {
      "default": "openai-images",
      "type": "string",
      "enum": ["omniroute", "9router", "openai-images", "openai-responses"]
    }
  },
  "required": ["api_endpoint", "api_key", "models"],
  "additionalProperties": false
}
